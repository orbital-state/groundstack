.:53 {
    errors
    health

    # Allowlist-only overrides for control-plane endpoints + storage data-plane wildcards.
    # Routes all matched names to the edge-proxy IP on the examples network.
    hosts {
        172.28.0.2 management.azure.com
        172.28.0.2 login.microsoftonline.com
        172.28.0.2 graph.microsoft.com
        fallthrough
    }

    template IN A {
        match (.*)\\.blob\\.core\\.windows\\.net\\.
        answer "{{ .Name }} 60 IN A 172.28.0.2"
        fallthrough
    }
    template IN A {
        match (.*)\\.file\\.core\\.windows\\.net\\.
        answer "{{ .Name }} 60 IN A 172.28.0.2"
        fallthrough
    }
    template IN A {
        match (.*)\\.queue\\.core\\.windows\\.net\\.
        answer "{{ .Name }} 60 IN A 172.28.0.2"
        fallthrough
    }
    template IN A {
        match (.*)\\.table\\.core\\.windows\\.net\\.
        answer "{{ .Name }} 60 IN A 172.28.0.2"
        fallthrough
    }
    template IN A {
        match (.*)\\.dfs\\.core\\.windows\\.net\\.
        answer "{{ .Name }} 60 IN A 172.28.0.2"
        fallthrough
    }
    template IN A {
        match (.*)\\.web\\.core\\.windows\\.net\\.
        answer "{{ .Name }} 60 IN A 172.28.0.2"
        fallthrough
    }

    forward . 1.1.1.1 8.8.8.8
    cache 30
}
